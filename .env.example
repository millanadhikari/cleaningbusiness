NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CONVEX_URL=

# Configure these on the Convex deployment, not as NEXT_PUBLIC variables.
# CLERK_SECRET_KEY is also required there to send and complete admin invitations.
RESEND_API_KEY=
EMAIL_FROM=We Do Cleaning <onboarding@resend.dev>
EMAIL_REPLY_TO=wedocleaning99@gmail.com
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3000
# Optional; defaults to wedocleaning_checkout_kqmvzrta.
STRIPE_INTEGRATION_IDENTIFIER=

# Configure these in both the Next.js/Vercel environment and Convex.
# Keep all three server-only; never use NEXT_PUBLIC_ names for Gmail OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.wedocleaning.com.au/api/google/callback

# Configure these on the Convex deployment for Gmail push notifications.
GMAIL_PUBSUB_TOPIC=projects/your-google-cloud-project/topics/gmail-push
GMAIL_PUBSUB_AUDIENCE=https://agreeable-possum-344.convex.site/google/gmail/push
GMAIL_PUBSUB_SERVICE_ACCOUNT=gmail-push@your-google-cloud-project.iam.gserviceaccount.com

# Configure these in the Next.js/Vercel environment only.
# Grant the service account Viewer access to the GA4 property. Keep credentials server-only.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Configure these on the Convex deployment only. Never use NEXT_PUBLIC_ names.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional; defaults to a Workers AI model with function-calling support.
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Google Search Console read-only reporting. Supports sc-domain: or URL-prefix properties.
# If the optional Search Console credentials are omitted, the GA4 service account is reused.
SEARCH_CONSOLE_SITE_URL=sc-domain:wedocleaning.com.au
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=
